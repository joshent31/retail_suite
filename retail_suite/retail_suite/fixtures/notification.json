  "channel": "System Notification",
  "condition": "doc.workflow_state == \"Completed\"",
  "date_changed": "workflow_state",
  "days_in_advance": null,
  "message": "<p>Production Order {{ doc.name }} for style {{ doc.style }} has been marked Completed.</p>",
  "enabled": 1,
  "recipients": [
