[
 {
  "doctype": "Notification",
  "name": "Consignment Settlement Due",
  "subject": "Consignment {{ doc.name }} Pending Settlement",
  "document_type": "Accessory Consignment Stock",
  "event": "Days After",
  "channel": "System Notification",
  "condition": "doc.workflow_state != \"Settled\"",
  "date_changed": "consignment_date",
  "days_in_advance": 30,
  "message": "<p>Consignment {{ doc.name }} from {{ doc.supplier }} is over 30 days old and not yet settled.</p>",
  "enabled": 1,
  "recipients": [
   {
    "receiver_by_role": "Accessories Manager"
   }
  ],
  "is_standard": 1
 },
 {
  "doctype": "Notification",
  "name": "Bundle Expiry Reminder",
  "subject": "Bundle {{ doc.bundle_name }} Expiring Soon",
  "document_type": "Accessory Item Bundle",
  "event": "Days Before",
  "channel": "System Notification",
  "condition": "",
  "date_changed": "valid_upto",
  "days_in_advance": 7,
  "message": "<p>Bundle offer {{ doc.bundle_name }} expires on {{ doc.valid_upto }}.</p>",
  "enabled": 1,
  "recipients": [
   {
    "receiver_by_role": "Accessories Manager"
   }
  ],
  "is_standard": 1
 }
